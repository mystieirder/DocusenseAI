# ═══════════════════════════════════════════════════════════════════════
#  DocuSense AI — PRODUCTION env template (free-tier cloud deploy)
# ═══════════════════════════════════════════════════════════════════════
#  For Render/HF, set these in the host dashboard (do NOT commit real values).
#  For a local Docker test:  cp .env.render.example .env.render  → fill in →
#    docker build -t docusense .  &&  docker run -p 7860:7860 --env-file .env.render docusense
#  Full walkthrough: DEPLOY.md
# ------------------------------------------------------------------------

# ── App / mode ──────────────────────────────────────────────────────────
ENV=production
DEBUG=false
SERVE_FRONTEND=true          # one service serves API + frontend (same-origin)
INGEST_MODE=thread           # ingest in a background thread (no Celery/Redis)
EMBED_BACKEND=gemini         # embed via Gemini API (no torch → fits 512 MB)
GEMINI_EMBED_DIM=768

# ── Auth ──────────────────────────────────────────────────────────────
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# (On Render, the Blueprint auto-generates this — leave it out there.)
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional — JSON array of emails that get the 'admin' role on register/login:
# ADMIN_EMAILS=["you@example.com"]

# ── Database — Supabase Postgres (Dashboard → "Connect" → Session pooler) ──
# IMPORTANT: Render's free tier is IPv4-only, but Supabase's DIRECT host
# (db.<ref>.supabase.co) is IPv6-only. You MUST use the SESSION POOLER host
# (aws-0-<region>.pooler.supabase.com, user postgres.<ref>). Then:
#   (1) change the scheme to postgresql+psycopg   (2) append ?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── LLM (Gemini) — required for chat / summary / explain / embeddings ────
GEMINI_API_KEY=
# Chat model. If chat 503s with a model error, IDs may have rotated —
# verify with GET /v1beta/models?key=... and override here.
GEMINI_MODEL=gemini-3.6-flash

# ── Object storage — Supabase Storage S3 gateway ────────────────────────
# Create a bucket in the dashboard, then Storage → Settings → S3 access keys.
# Endpoint form: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_PUBLIC_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=docusense-documents
S3_REGION=us-east-1          # match your Supabase project region
S3_ADDRESSING_STYLE=path     # managed S3 gateways require path-style
S3_USE_SSE=false             # Supabase/R2 reject AES-256 SSE headers
PRESIGN_EXPIRE_SECONDS=3600

# ── Retrieval / limits ──────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
HYBRID_ALPHA=0.5
MAX_UPLOAD_MB=50
MAX_PAGES=300
OCR_PAGE_LIMIT=60

# ── CORS ─────────────────────────────────────────────────────────────────
# Empty ⇒ CORS middleware disabled (fine when SERVE_FRONTEND serves same-origin).
# If you host the UI separately, put its exact origin: ["https://your-ui.example"]
CORS_ORIGINS=[]
