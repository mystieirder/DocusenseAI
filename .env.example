# ── Copy to .env and fill in. docker-compose reads this file. ──────────

# App
ENV=development
DEBUG=true
SERVE_FRONTEND=false          # compose uses the nginx `frontend` service instead

# Auth — GENERATE A REAL SECRET:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional — JSON array of emails granted the 'admin' role:
# ADMIN_EMAILS=["you@example.com"]

# Database (matches the postgres service in docker-compose)
DATABASE_URL=postgresql+psycopg://docusense:docusense@postgres:5432/docusense

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
INGEST_MODE=celery            # compose runs a Celery worker; "thread" for single-process

# Object storage — MinIO by default (S3-compatible, local).
# For real AWS S3: set S3_ENDPOINT_URL="" and S3_PUBLIC_ENDPOINT_URL="",
# then provide real keys/region/bucket.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=docusense
S3_SECRET_KEY=docusense-secret
S3_BUCKET=docusense-documents
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=auto       # "path" for Supabase/R2; MinIO/AWS work with "auto"
S3_USE_SSE=true                # MinIO honors AES-256; set false for Supabase/R2
PRESIGN_EXPIRE_SECONDS=3600

# LLM (required for chat / summary / explain)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Embeddings / retrieval
EMBED_BACKEND=local            # local | gemini | keyword
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
RETRIEVAL_TOP_K=8
HYBRID_ALPHA=0.5

# Ingestion limits
MAX_UPLOAD_MB=50
MAX_PAGES=300
OCR_PAGE_LIMIT=60

# CORS (frontend origin)
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
